# Local dev: SQLite file. Production: postgresql://user:password@host:5432/medtrail (Supabase / Neon)
DATABASE_URL=sqlite:///./medtrail.db
DB_POOL_SIZE=10

# demo = pick the user with the X-Demo-User header (hackathon demo)
# jwt  = Authorization: Bearer <token> signed with JWT_SECRET (e.g. Supabase Auth JWT secret)
AUTH_MODE=demo
JWT_SECRET=
JWT_AUDIENCE=authenticated

# Demo controls (/api/__demo/*), simulated users and seed data. Turn off in production.
DEMO_MODE=true
SEED_ON_START=true

# Load protection: requests handled at once per instance, and per-user rate limit.
MAX_CONCURRENCY=24
USER_RATE_PER_SEC=30
USER_BURST=100

# Uploads. SIGNING_SECRET must be the same on every instance.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
SIGNING_SECRET=change-me-to-a-long-random-string
RUN_WORKER_IN_PROCESS=true

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
